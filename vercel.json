{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",

  "regions": ["fra1"],

  "functions": {
    "app/api/**/route.ts": {
      "maxDuration": 60
    }
  },

  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
