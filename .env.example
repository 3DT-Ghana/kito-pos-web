# ---------------------------------------------------------------------------
# Copy to .env.local for local development. On Vercel these live in
# Settings → Environment Variables. Never commit real values.
# ---------------------------------------------------------------------------

# === Database — Neon Postgres ==============================================
# DATABASE_URL is the POOLED endpoint — the host contains "-pooler". All
# application traffic goes through it.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DIRECT_URL is the UNPOOLED endpoint (same host without "-pooler"). Prisma
# Migrate needs it because DDL cannot run through PgBouncer.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"


# === Authentication — NextAuth ==============================================
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-32-plus-random-characters"

# Canonical public URL. Must be the Cloudflare-fronted domain in production, not
# the *.vercel.app URL, or sign-in callbacks redirect to the wrong host.
NEXTAUTH_URL="https://pos.example.com"

# Comma-separated emails that get platform SUPER_ADMIN access.
SUPER_ADMIN_EMAILS="owner@example.com"

# Shared secret for out-of-band approval grants.
APPROVAL_GRANT_SECRET="replace-me"


# === Object storage — Cloudflare R2 =========================================
# Cloudflare dashboard → R2 → Manage API tokens (Object Read & Write).
# The bucket must stay PRIVATE: files are streamed through /api/files/[...key],
# which authorises the caller first.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="market-inventory-documents"

# Optional. Only set for a jurisdiction-restricted bucket, e.g.
# https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=""


# === Email — SMTP ===========================================================
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Market Inventory <noreply@example.com>"


# === Self-hosted (Hetzner) only =============================================
# Read by docker/docker-compose.yml and docker/Caddyfile, not by the app. They
# live in /etc/pos/app.env on the host and are unused on Vercel. APP_DOMAIN is
# the hostname Caddy requests a Let's Encrypt certificate for; ACME_EMAIL is
# where Let's Encrypt sends expiry warnings. See DEPLOYMENT.md §6.
# APP_DOMAIN="pos.example.com"
# ACME_EMAIL="admin@example.com"


# === Deployment behaviour ===================================================
# Preview builds skip `prisma migrate deploy` by default so they cannot alter the
# production database. Set to "true" only when previews use their own Neon branch.
# ALLOW_PREVIEW_MIGRATIONS="false"
