// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// ENUMS
// =====================

enum Role {
  OWNER
  STORE_MANAGER
  BRANCH_MANAGER
  CASHIER
  INVENTORY_MANAGER
  ACCOUNTANT
  STAFF
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum PaymentType {
  CASH
  CREDIT
}

enum PaymentMethod {
  CASH
  MOMO
  BANK
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
}

enum ReturnType {
  CASH
  CREDIT
  EXCHANGE
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// =====================
// ACCOUNTING ENUMS
// =====================

enum ItemType {
  INVENTORY     // physical stock — tracks quantity and inventory value
  NON_INVENTORY // appears on invoices/bills, no stock tracking
  SERVICE       // services — no stock, no inventory value
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
}

enum NormalBalance {
  DEBIT   // increases with debit: Assets, COGS, Expenses
  CREDIT  // increases with credit: Liabilities, Equity, Revenue
}

enum JournalEntryStatus {
  POSTED    // live, affects balances
  REVERSED  // cancelled by a reversal entry
  VOID      // manually voided (OWNER only)
}

enum JournalSource {
  SALE
  PURCHASE
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  EXPENSE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  STOCK_ADJUSTMENT
  TRANSFER
  MANUAL
  PAYROLL
}

enum TaxCalculationType {
  ADD_TO_PRICE
  INCLUSIVE
}

enum TaxTransactionType {
  SALE
  QUOTATION
  CUSTOMER_RETURN
}

// =====================
// PAYROLL ENUMS
// =====================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum PayrollRunStatus {
  DRAFT     // being built, can be edited
  APPROVED  // locked, reviewed by manager
  PAID      // disbursed, journal posted
}

enum SsfTier {
  TIER1  // mandatory 5.5% employee + 13% employer
  TIER2  // occupational pension — employer top-up
  TIER3  // voluntary provident fund
}

enum PayrollComponentType {
  ALLOWANCE
  DEDUCTION
}

// =====================
// AGENT / PLATFORM ENUMS
// =====================

enum AgentStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessType {
  SHOP
  COMPANY
  OTHER
}

enum BusinessApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DocumentType {
  BUSINESS_CERTIFICATE
  GHANA_CARD_FRONT
  GHANA_CARD_BACK
  OTHER
}

// =====================
// APPROVAL ENUMS
// =====================

enum ApprovalStatus {
  PENDING   // waiting for a manager to approve or reject
  APPROVED  // approved — side effects (stock, balance, journal) already committed
  REJECTED  // rejected — no side effects applied
}

enum ApprovalFlag {
  DISCOUNT          // sale has a line or order-level discount
  PRICE_OVERRIDE    // cashier set a price below the catalogue price
  CREDIT_SALE       // paidAmount < totalAmount (credit extended)
  STOCK_ADJUSTMENT  // manual stock add/remove/set
}

enum WaybillStatus {
  DRAFT       // created, not yet dispatched
  DISPATCHED  // goods in transit to consignee
  DELIVERED   // confirmed received by consignee
  CANCELLED   // voided
}

enum TransferPartyType {
  CUSTOMER  // party is a Customer record
  SUPPLIER  // party is a Supplier record
  ACCOUNT   // party is a ledger Account record
}

// =====================
// CORE MULTI-TENANT
// =====================

model Tenant {
  id        String       @id @default(uuid())
  name      String
  phone     String?
  status    TenantStatus @default(TRIAL)
  users     User[]
  branches  Branch[]
  createdAt DateTime     @default(now())

  // Receipt Settings
  showManufacturerOnReceipt Boolean @default(true)
  receiptPrinterWidth       String  @default("80mm") // "58mm" or "80mm"
  receiptPrinterName        String? // QZ Tray printer name for POS receipts
  reportPrinterName         String? // QZ Tray printer name for invoices/reports (A4)

  // Unit System
  // When enabled, items have a unit name (e.g. "carton") and piecesPerUnit (e.g. 12).
  // Stock is tracked in the base unit (cartons). Quantities can be fractional (1.5 cartons).
  useUnitSystem Boolean @default(false)

  // Pricing Tiers — when enabled, items carry extra price tiers selectable at sale time
  enableRetailPrice    Boolean @default(false)
  enableWholesalePrice Boolean @default(false)
  enablePromoPrice     Boolean @default(false)

  // Discounts — when enabled, cashier can apply a discount (% or fixed amount) per sale
  enableDiscounts Boolean @default(false)

  // SMS Notifications — Hubtel Ghana SMS Gateway
  enableSmsNotifications Boolean @default(false)
  hubtelClientId         String?
  hubtelClientSecret     String?
  hubtelSenderId         String? // e.g. "MYBIZ" (max 11 chars, no spaces)

  // WhatsApp Notifications — Meta WhatsApp Business Cloud API
  enableWhatsApp         Boolean @default(false)
  metaWabaToken          String? // permanent system user token from Meta
  metaWabaPhoneNumberId  String? // Phone Number ID from Meta WABA dashboard

  // Feature Flags — enable/disable optional modules from Settings
  enablePosTerminal    Boolean @default(false)
  enableQuotations     Boolean @default(false)
  enablePurchaseOrders Boolean @default(false)
  enableExpiryTracking Boolean @default(false)
  enableBranches       Boolean @default(false)
  enableCreditSales    Boolean @default(false)
  enableExpenses       Boolean @default(false)
  enableTill           Boolean @default(false)

  // Sales behaviour
  allowSaleOnZeroStock Boolean @default(false)

  // Barcode / Label printing
  enableBarcodeGenerator Boolean @default(false)

  // Accounting module — double-entry ledger, COA, journal entries
  enableAccounting Boolean @default(false)

  // Payroll module — Ghana payroll with PAYE, SSF, SSNIT deductions
  enablePayroll Boolean @default(false)

  // Transaction approval — when enabled, sensitive operations by CASHIER/STAFF require approval
  requireApproval Boolean @default(false)

  // Agent onboarding — which platform agent onboarded this tenant (null = self-signup)
  agentId String?

  // Role permission overrides — JSON map of role → string[]
  // When set, overrides the default PERMISSIONS constant in rbac.ts for that role
  rolePermissions Json?

  // Accounting relations
  accounts        Account[]
  journalEntries  JournalEntry[]
  ledgerTransfers LedgerTransfer[]
  taxSetting      TenantTaxSetting?
  taxRates        TaxRate[]
  transactionTaxLines TransactionTaxLine[]

  // Payroll relations
  employeeIdPrefix  String?   // prefix for auto-generated staffIds e.g. "ABC" → "ABC-EMP-0001"
  employees         Employee[]
  payrollRuns       PayrollRun[]
  payrollComponents PayrollComponent[]
  statutoryDeductions StatutoryDeduction[]
  payrollDepartments  PayrollDepartment[]
}

// =====================
// USERS & AUTH
// =====================

model User {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  name             String
  email            String            @unique
  password         String
  isActive         Boolean           @default(true)
  approvalPin      String?
  role             Role
  branchId         String?
  branch           Branch?           @relation(fields: [branchId], references: [id])
  createdAt        DateTime          @default(now())
  stockAdjustments StockAdjustment[]
  payrollRunsCreated  PayrollRun[] @relation("PayrollRunCreatedBy")
  payrollRunsApproved PayrollRun[] @relation("PayrollRunApprovedBy")
  payrollRunsPaid     PayrollRun[] @relation("PayrollRunPaidBy")
  approvedTransactions TransactionApproval[] @relation("ApprovedBy")
  createdTransactions  TransactionApproval[] @relation("CreatedBy")
  salesCreated         Sale[]               @relation("SaleCreatedBy")
}

// =====================
// BRANCHES
// =====================

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  phone     String?
  isDefault Boolean  @default(false) // one branch per tenant is the "main" branch
  createdAt DateTime @default(now())

  users User[]
}

// =====================
// MANUFACTURERS
// =====================

model Manufacturer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  items     Item[]
  createdAt DateTime @default(now())
}

// =====================
// PRODUCT CATEGORIES
// =====================

model Category {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  color       String?  @default("#6366f1") // hex colour for UI badge
  icon        String?  @default("📦") // emoji icon
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  items Item[]
}

// =====================
// ITEMS & INVENTORY
// =====================

model Item {
  id             String       @id @default(uuid())
  tenantId       String
  branchId       String?
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  name           String
  quantity       Float        @default(0)
  reorderLevel   Int          @default(10)
  costPrice      Float
  sellingPrice   Float
  retailPrice    Float?
  wholesalePrice Float?
  promoPrice     Float?
  barcode        String?
  expiryDate     DateTime?
  createdAt      DateTime     @default(now())

  // Unit System fields (only meaningful when tenant.useUnitSystem = true)
  unitName      String? @default("unit")
  piecesPerUnit Int?    @default(1)

  // Item type — controls stock tracking and accounting behaviour
  itemType      ItemType @default(INVENTORY)

  // Accounting account assignments (only used when enableAccounting = true)
  incomeAccountId  String?
  cogsAccountId    String?
  expenseAccountId String?
  incomeAccount    Account? @relation("ItemIncomeAccount",  fields: [incomeAccountId],  references: [id])
  cogsAccount      Account? @relation("ItemCogsAccount",    fields: [cogsAccountId],    references: [id])
  expenseAccount   Account? @relation("ItemExpenseAccount", fields: [expenseAccountId], references: [id])
  productTaxSetting ProductTaxSetting?

  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]
  customerReturns  CustomerReturn[]
  supplierReturns  SupplierReturn[]
  stockAdjustments StockAdjustment[]
}

// =====================
// CUSTOMERS (DEBTORS)
// =====================

model Customer {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  phone    String?
  balance  Float   @default(0)
  sales    Sale[]
  payments CustomerPayment[]
  debitTransfers  LedgerTransfer[] @relation("TransferDebitCustomer")
  creditTransfers LedgerTransfer[] @relation("TransferCreditCustomer")
}

// =====================
// SUPPLIERS (CREDITORS)
// =====================

model Supplier {
  id        String     @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  balance   Float      @default(0)
  purchases Purchase[]
  payments  SupplierPayment[]
  debitTransfers  LedgerTransfer[] @relation("TransferDebitSupplier")
  creditTransfers LedgerTransfer[] @relation("TransferCreditSupplier")
}

// =====================
// SALES
// =====================

model Sale {
  id            String           @id @default(uuid())
  tenantId      String
  branchId      String? // optional: which branch this sale was made at
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id])
  subtotalAmount Float           @default(0)
  taxAmount      Float           @default(0)
  totalAmount   Float
  paidAmount    Float
  paymentType   PaymentType // CASH = fully paid, CREDIT = balance owed
  paymentMethod     PaymentMethod @default(CASH) // how money was received: CASH, MOMO, BANK
  momoPhone         String?       // captured when paymentMethod = MOMO
  bankName          String?       // captured when paymentMethod = BANK (sales invoice only)
  bankAccountName   String?       // account holder name
  bankReference     String?       // transaction / reference number
  note              String?       // free-text note captured at the till
  // Set when this sale was created by converting a quotation. Unique, so a
  // quotation can never be converted into a second sale.
  sourceQuotationId String?       @unique
  createdAt         DateTime      @default(now())
  items         SaleItem[]
  returns       CustomerReturn[]
  taxLines      TransactionTaxLine[] @relation("SaleTaxLines")

  // Approval workflow — null means no approval required (auto-approved)
  approvalStatus   ApprovalStatus?
  approvalFlags    ApprovalFlag[]  // which flags triggered approval requirement
  createdById      String?         // who initiated the sale
  createdBy        User?           @relation("SaleCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, approvalStatus])
}

model SaleItem {
  id                  String               @id @default(uuid())
  saleId         String
  sale           Sale                 @relation(fields: [saleId], references: [id])
  itemId         String
  item           Item                 @relation(fields: [itemId], references: [id])
  quantity       Float // Float supports fractional units
  price          Float
  discountAmount Float                @default(0) // per-line discount in currency
  isTaxable      Boolean              @default(false)
  taxCalculationType TaxCalculationType?
  lineSubtotalAmount Float            @default(0)
  lineTaxAmount   Float               @default(0)
  lineTotalAmount Float               @default(0)
  taxLines        TransactionTaxLine[] @relation("SaleItemTaxLines")
}

// =====================
// PURCHASES
// =====================
model Purchase {
  id          String           @id @default(uuid())
  tenantId    String
  branchId    String? // optional: which branch received this purchase
  supplierId  String
  supplier    Supplier         @relation(fields: [supplierId], references: [id])
  totalAmount Float
  paidAmount  Float
  paymentType PaymentType
  // Set when this purchase was created by receiving a purchase order. Unique,
  // so a PO can never be received into a second purchase.
  sourcePurchaseOrderId String? @unique
  createdAt   DateTime         @default(now())
  items       PurchaseItem[]
  returns     SupplierReturn[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  quantity   Float // Float supports fractional units
  costPrice  Float
}

// =====================
// PAYMENTS
// =====================

model CustomerPayment {
  id              String        @id @default(uuid())
  tenantId        String
  branchId        String?
  customerId      String
  // Without this relation the payments history page could never resolve a
  // name and rendered "Unknown" for every row.
  customer        Customer      @relation(fields: [customerId], references: [id])
  amount          Float
  method          PaymentMethod
  momoPhone       String?       // captured when method = MOMO
  bankName        String?       // captured when method = BANK
  bankAccountName String?
  bankReference   String?
  createdAt       DateTime      @default(now())
}

model SupplierPayment {
  id              String        @id @default(uuid())
  tenantId        String
  branchId        String?
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  amount          Float
  method          PaymentMethod
  momoPhone       String?       // captured when method = MOMO
  bankName        String?       // captured when method = BANK
  bankAccountName String?
  bankReference   String?
  createdAt       DateTime      @default(now())
}

// =====================
// RETURNS
// =====================

model CustomerReturn {
  id        String     @id @default(uuid())
  tenantId  String
  saleId    String
  sale      Sale       @relation(fields: [saleId], references: [id])
  itemId    String
  item      Item       @relation(fields: [itemId], references: [id])
  quantity  Float
  type      ReturnType
  subtotalAmount Float @default(0)
  taxAmount Float      @default(0)
  amount    Float
  note      String?
  createdAt DateTime   @default(now())
  taxLines  TransactionTaxLine[] @relation("CustomerReturnTaxLines")
}

model SupplierReturn {
  id         String     @id @default(uuid())
  tenantId   String
  purchaseId String
  purchase   Purchase   @relation(fields: [purchaseId], references: [id])
  itemId     String
  item       Item       @relation(fields: [itemId], references: [id])
  quantity   Float
  type       ReturnType
  amount     Float
  note       String?
  createdAt  DateTime   @default(now())
}

// =====================
// STOCK ADJUSTMENTS
// =====================

model StockAdjustment {
  id               String              @id @default(uuid())
  tenantId         String
  branchId         String?
  itemId           String
  userId           String?
  type             StockAdjustmentType
  category         String              @default("other")
  quantity         Float
  previousQuantity Float               @default(0)
  newQuantity      Float               @default(0)
  reason           String
  createdAt        DateTime            @default(now())

  // Approval workflow — null means no approval required
  approvalStatus ApprovalStatus? // null = auto-approved (manager performed it directly)

  item Item  @relation(fields: [itemId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId, approvalStatus])
}

// =====================
// TRANSACTION APPROVALS
// =====================

// Unified approval record linking to a Sale or StockAdjustment
model TransactionApproval {
  id          String         @id @default(uuid())
  tenantId    String
  flag        ApprovalFlag   // the primary reason this needs approval
  status      ApprovalStatus @default(PENDING)

  // Exactly one of these is set
  saleId            String?
  stockAdjustmentId String?

  createdById  String   // who submitted the transaction
  createdBy    User     @relation("CreatedBy",  fields: [createdById],  references: [id])
  approvedById String?  // who approved/rejected
  approvedBy   User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  note         String?  // optional rejection/approval note

  createdAt DateTime @default(now())

  @@index([tenantId, status])
  @@index([tenantId, saleId])
  @@index([tenantId, stockAdjustmentId])
}

/// Records approval grants that have already been redeemed.
///
/// A grant is a short-lived signed token minted when a manager enters their
/// PIN. Without a consumption record it is a bearer token: whoever holds it can
/// replay it until it expires. The unique jti makes redemption single-use.
model ConsumedApprovalGrant {
  id         String   @id @default(uuid())
  tenantId   String
  jti        String   @unique // unique id carried inside the signed grant
  saleId     String?  // which sale it was redeemed against
  approverId String
  consumedAt DateTime @default(now())

  @@index([tenantId, consumedAt])
}

// =====================
// EXPENSES
// =====================

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  TRANSPORT
  MARKETING
  MAINTENANCE
  OTHER
}

model Expense {
  id          String          @id @default(uuid())
  tenantId    String
  branchId    String? // optional: which branch incurred this expense
  amount      Float
  category    ExpenseCategory
  description String
  // How the expense was paid. Without this the till deducted every expense
  // from the physical drawer, so a bank-paid bill created a false shortage.
  method      PaymentMethod   @default(CASH)
  paidBy      String?
  createdAt   DateTime        @default(now())
}

// =====================
// TILL / CASH REGISTER
// =====================

enum ShiftStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id           String      @id @default(uuid())
  tenantId     String
  branchId     String? // optional: which branch this till belongs to
  userId       String
  status       ShiftStatus @default(OPEN)
  openingFloat Float // cash in till at shift start
  closingCount Float? // cash counted at shift close
  expectedCash Float? // calculated: float + cash sales + payments
  variance     Float? // closingCount - expectedCash
  note         String?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?

  @@index([tenantId, branchId, userId, status])
}

// =====================
// INTER-BRANCH TRANSFERS
// =====================

model StockTransfer {
  id                 String              @id @default(uuid())
  tenantId           String
  fromBranchId       String
  toBranchId         String
  status             StockTransferStatus @default(PENDING)
  note               String?
  initiatedByUserId  String
  dispatchedByUserId String?
  receivedByUserId   String?
  dispatchedAt       DateTime?
  receivedAt         DateTime?
  createdAt          DateTime            @default(now())
  items              StockTransferItem[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, fromBranchId, createdAt])
  @@index([tenantId, toBranchId, createdAt])
}

model StockTransferItem {
  id              String        @id @default(uuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  sourceItemId    String
  manufacturerId  String
  categoryId      String?
  itemName        String
  barcode         String?
  expiryDate      DateTime?
  unitName        String?
  piecesPerUnit   Int?
  quantity        Float
  costPrice       Float
  sellingPrice    Float
  retailPrice     Float?
  wholesalePrice  Float?
  promoPrice      Float?

  @@index([stockTransferId])
}

// =====================
// QUOTATIONS
// =====================

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED // terminal — a sale has been created from this quotation
}

model Quotation {
  id          String          @id @default(uuid())
  tenantId    String
  branchId    String?
  customerId  String?
  status      QuotationStatus @default(DRAFT)
  subtotalAmount Float        @default(0)
  taxAmount Float             @default(0)
  totalAmount Float
  note        String?
  validUntil  DateTime?
  createdAt   DateTime        @default(now())
  items       QuotationItem[]
  taxLines    TransactionTaxLine[] @relation("QuotationTaxLines")

  @@index([tenantId, status, createdAt])
  @@index([tenantId, branchId, createdAt])
}

model QuotationItem {
  id          String               @id @default(uuid())
  quotationId String
  quotation   Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId      String
  itemName    String // snapshot of name at time of quote
  quantity    Float
  price       Float
  discountAmount Float            @default(0)
  isTaxable      Boolean          @default(false)
  taxCalculationType TaxCalculationType?
  lineSubtotalAmount Float        @default(0)
  lineTaxAmount   Float           @default(0)
  lineTotalAmount Float           @default(0)
  taxLines        TransactionTaxLine[] @relation("QuotationItemTaxLines")
}

// =====================
// PURCHASE ORDERS
// =====================

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  tenantId    String
  branchId    String? // optional: which branch this purchase order belongs to
  supplierId  String?
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Float
  note        String?
  expectedAt  DateTime?
  createdAt   DateTime            @default(now())
  items       PurchaseOrderItem[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, branchId, createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  itemName        String // snapshot of name at time of order
  quantity        Float
  costPrice       Float
}

// =====================
// AUDIT LOGS
// =====================

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId, createdAt])
  @@index([tenantId, userId, createdAt])
}

// =====================
// TAXES
// =====================

model TenantTaxSetting {
  id                        String             @id @default(uuid())
  tenantId                  String             @unique
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxEnabled                Boolean            @default(false)
  defaultTaxCalculationType TaxCalculationType @default(ADD_TO_PRICE)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
}

model TaxRate {
  id                  String      @id @default(uuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  ratePercentage      Float
  description         String?
  isDefault           Boolean     @default(false)
  isActive            Boolean     @default(true)
  taxPayableAccountId String?
  taxPayableAccount   Account?    @relation("TaxPayableAccount", fields: [taxPayableAccountId], references: [id])
  effectiveFrom       DateTime    @default(now())
  effectiveTo         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  productTaxSettings ProductTaxSetting[] @relation("ProductPrimaryTaxRate")
  productTaxRateLinks ProductTaxRate[]
  transactionTaxLines TransactionTaxLine[]

  @@index([tenantId, isActive, isDefault])
  @@index([tenantId, name])
  @@index([tenantId, effectiveFrom, effectiveTo])
}

model ProductTaxSetting {
  id                   String             @id @default(uuid())
  productId            String             @unique
  product              Item               @relation(fields: [productId], references: [id], onDelete: Cascade)
  isTaxable            Boolean            @default(false)
  taxRateId            String?
  taxRate              TaxRate?           @relation("ProductPrimaryTaxRate", fields: [taxRateId], references: [id])
  taxCalculationType   TaxCalculationType?
  useTenantDefaultTaxes Boolean           @default(true)
  taxRates             ProductTaxRate[]
}

model ProductTaxRate {
  id                  String            @id @default(uuid())
  productTaxSettingId String
  productTaxSetting   ProductTaxSetting @relation(fields: [productTaxSettingId], references: [id], onDelete: Cascade)
  taxRateId           String
  taxRate             TaxRate           @relation(fields: [taxRateId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([productTaxSettingId, taxRateId])
  @@index([taxRateId])
}

model TransactionTaxLine {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionType   TaxTransactionType
  transactionId     String
  transactionLineId String
  saleId            String?
  sale              Sale?              @relation("SaleTaxLines", fields: [saleId], references: [id], onDelete: Cascade)
  saleItemId        String?
  saleItem          SaleItem?          @relation("SaleItemTaxLines", fields: [saleItemId], references: [id], onDelete: Cascade)
  quotationId       String?
  quotation         Quotation?         @relation("QuotationTaxLines", fields: [quotationId], references: [id], onDelete: Cascade)
  quotationItemId   String?
  quotationItem     QuotationItem?     @relation("QuotationItemTaxLines", fields: [quotationItemId], references: [id], onDelete: Cascade)
  customerReturnId  String?
  customerReturn    CustomerReturn?    @relation("CustomerReturnTaxLines", fields: [customerReturnId], references: [id], onDelete: Cascade)
  taxRateId         String?
  taxRate           TaxRate?           @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  taxName           String
  taxRatePercentage Float
  taxableAmount     Float
  taxAmount         Float
  calculationType   TaxCalculationType
  createdAt         DateTime           @default(now())

  @@index([tenantId, transactionType, transactionId])
  @@index([tenantId, taxName, createdAt])
  @@index([saleId])
  @@index([quotationId])
  @@index([customerReturnId])
}

// =====================
// ACCOUNTING MODULE
// =====================

model Account {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  code          String      // e.g. "1010", unique per tenant
  name          String
  type          AccountType
  normalBalance NormalBalance
  parentId      String?
  parent        Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      Account[]   @relation("AccountHierarchy")
  isSystemAccount Boolean   @default(false) // system accounts cannot be deleted or renamed
  isActive        Boolean   @default(true)
  description     String?
  createdAt       DateTime  @default(now())

  lines            JournalLine[]
  itemsIncome      Item[]        @relation("ItemIncomeAccount")
  itemsCogs        Item[]        @relation("ItemCogsAccount")
  itemsExpense     Item[]        @relation("ItemExpenseAccount")
  taxRates         TaxRate[]     @relation("TaxPayableAccount")
  debitTransfers   LedgerTransfer[] @relation("TransferDebitAccount")
  creditTransfers  LedgerTransfer[] @relation("TransferCreditAccount")

  @@unique([tenantId, code])
  @@index([tenantId, type, isActive])
}

model JournalEntry {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  entryNumber String             // human-readable ref e.g. "JE-0001"
  date        DateTime           @default(now())
  description String
  source      JournalSource
  status      JournalEntryStatus @default(POSTED)

  // Source references — at most one is set per entry
  saleId            String?
  purchaseId        String?
  customerPaymentId String?
  supplierPaymentId String?
  expenseId         String?
  customerReturnId  String?
  supplierReturnId  String?
  stockAdjustmentId String?
  ledgerTransferId  String?
  payrollRunId      String?

  // Reversal linkage
  reversedById String?  // if reversed, points to the reversal JE id
  reversalOfId String?  // if this is a reversal, points to original JE id

  postedById  String
  createdAt   DateTime      @default(now())
  lines       JournalLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, date, source])
  @@index([tenantId, saleId])
  @@index([tenantId, purchaseId])
  @@index([tenantId, expenseId])
  @@index([tenantId, customerPaymentId])
  @@index([tenantId, supplierPaymentId])
  @@index([tenantId, customerReturnId])
  @@index([tenantId, supplierReturnId])
  @@index([tenantId, stockAdjustmentId])
  @@index([tenantId, ledgerTransferId])
  @@index([tenantId, payrollRunId])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
}

// =====================
// LEDGER TRANSFERS
// =====================

// A LedgerTransfer moves value between any two parties:
//   Customer ↔ Customer, Supplier ↔ Supplier, Customer ↔ Supplier,
//   or any party ↔ a ledger Account.
// Each transfer always produces a balanced JournalEntry (TRANSFER source).
model LedgerTransfer {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  amount      Float
  description String
  date        DateTime @default(now())

  // Debit side (the party losing value / being debited)
  debitPartyType  TransferPartyType
  debitCustomerId  String?
  debitSupplierId  String?
  debitAccountId   String?
  debitCustomer    Customer? @relation("TransferDebitCustomer",  fields: [debitCustomerId],  references: [id])
  debitSupplier    Supplier? @relation("TransferDebitSupplier",  fields: [debitSupplierId],  references: [id])
  debitAccount     Account?  @relation("TransferDebitAccount",   fields: [debitAccountId],   references: [id])

  // Credit side (the party gaining value / being credited)
  creditPartyType TransferPartyType
  creditCustomerId String?
  creditSupplierId String?
  creditAccountId  String?
  creditCustomer   Customer? @relation("TransferCreditCustomer", fields: [creditCustomerId], references: [id])
  creditSupplier   Supplier? @relation("TransferCreditSupplier", fields: [creditSupplierId], references: [id])
  creditAccount    Account?  @relation("TransferCreditAccount",  fields: [creditAccountId],  references: [id])

  // Journal linkage
  journalEntryId String?

  postedById  String
  createdAt   DateTime @default(now())

  @@index([tenantId, date])
  @@index([tenantId, debitCustomerId])
  @@index([tenantId, creditCustomerId])
  @@index([tenantId, debitSupplierId])
  @@index([tenantId, creditSupplierId])
}

// =====================
// PAYROLL
// =====================

// A single employee in the payroll system.
// Separate from User — employees don't need system access.
model Employee {
  id         String @id @default(uuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  staffId    String  // auto-generated or manual e.g. "ABC-EMP-0001"

  // Personal details
  firstName             String
  middleName            String?
  lastName              String
  gender                String?   // "MALE" | "FEMALE" | "OTHER"
  dateOfBirth           DateTime?
  tinNumber             String?
  ssnitNumber           String?
  residentialAddress    String?
  emergencyContactName  String?
  emergencyContactPhone String?

  email      String?
  phone      String?
  position   String  // job title
  department String?

  employmentType EmploymentType @default(FULL_TIME)

  // Compensation
  basicSalary      Float           // monthly gross base salary (GHS)
  ssfTier          SsfTier         @default(TIER1)
  isExemptFromPAYE Boolean         @default(false)

  // Bank details for disbursement
  bankName       String?
  bankBranch     String?
  accountNumber  String?

  // MoMo payment details
  momoProvider    String?   // "MTN" | "VODAFONE" | "AIRTELTIGO"
  momoNumber      String?
  momoAccountName String?

  // Status
  isActive  Boolean  @default(true)
  hireDate  DateTime @default(now())
  endDate   DateTime?

  createdAt DateTime @default(now())

  payrollLines PayrollLine[]
  components   EmployeePayrollComponent[]
  loans        EmployeeLoan[]

  @@unique([tenantId, staffId])
  @@index([tenantId, isActive])
  @@index([tenantId, department])
}

// A payroll run covers one calendar month for all active employees.
model PayrollRun {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  periodYear  Int   // e.g. 2025
  periodMonth Int   // 1–12

  status     PayrollRunStatus @default(DRAFT)

  // Totals (computed and stored for reporting without re-summing lines)
  totalGross           Float @default(0)
  totalSSFEmployee     Float @default(0)
  totalSSFEmployer     Float @default(0)
  totalPAYE            Float @default(0)
  totalDeductions      Float @default(0)
  totalNetPay          Float @default(0)

  // Audit
  createdById  String
  approvedById String?
  paidById     String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime @default(now())

  createdBy  User  @relation("PayrollRunCreatedBy",  fields: [createdById],  references: [id])
  approvedBy User? @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id])
  paidBy     User? @relation("PayrollRunPaidBy",     fields: [paidById],     references: [id])

  // Journal linkage (posted when status → PAID and accounting is enabled)
  journalEntryId String?

  lines PayrollLine[]

  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId, status])
  @@index([tenantId, periodYear, periodMonth])
}

// One row per employee per payroll run.
model PayrollLine {
  id           String     @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])

  // Input
  basicSalary Float
  overtime    Float @default(0)
  bonus       Float @default(0)

  // Component snapshots (JSON arrays frozen at run time)
  allowancesSnapshot Json @default("[]")  // [{name, amount, isTaxable}]
  deductionsSnapshot Json @default("[]")  // [{name, amount, isBeforeTax}]
  allowancesTotal    Float @default(0)
  deductionsTotal    Float @default(0)

  // Computed (Ghana statutory)
  grossPay      Float
  ssfEmployee   Float
  ssfEmployer   Float
  taxableIncome Float
  paye          Float
  netPay        Float

  createdAt DateTime @default(now())

  @@index([payrollRunId])
  @@index([employeeId])
}

// =====================
// PLATFORM — AGENTS & ONBOARDING
// =====================

model PlatformAdmin {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Agent {
  id                  String      @id @default(uuid())
  agentCode           String      @unique // e.g. "AGT-0001"
  fullName            String
  phone               String
  email               String      @unique
  passwordHash        String
  ghanaCardNumber     String?
  ghanaCardImageUrl   String?
  residentialAddress  String?
  territory           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  status              AgentStatus @default(PENDING)
  approvedAt          DateTime?
  approvedById        String?     // platform admin email
  rejectionReason     String?
  registeredByAdminEmail String?  // set when admin creates the agent directly
  onboardedBusinesses BusinessApplication[]
  commissions         AgentCommission[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model BusinessApplication {
  id                       String                    @id @default(uuid())
  businessName             String
  businessType             BusinessType              @default(SHOP)
  businessRegistrationNumber String?
  businessAddress          String
  businessPhone            String?
  businessEmail            String?
  gpsLatitude              Float?
  gpsLongitude             Float?

  // Directors / owners — stored as JSON array of { fullName, ghanaCardNumber? }
  directors                Json                      @default("[]")

  // Primary owner (legacy + quick access)
  ownerFullName            String
  ownerPhone               String
  ownerEmail               String
  ownerGhanaCardNumber     String?
  ownerGhanaCardImageUrl   String?

  status                   BusinessApplicationStatus @default(PENDING)
  rejectionReason          String?
  approvalNote             String?
  agentId                  String
  agent                    Agent                     @relation(fields: [agentId], references: [id])
  tenantId                 String?   // set when approved → tenant created
  reviewedById             String?   // platform admin email
  reviewedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  documents                BusinessDocument[]

  @@index([agentId])
  @@index([status])
}

model BusinessDocument {
  id            String       @id @default(uuid())
  applicationId String
  application   BusinessApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType  DocumentType
  label         String?      // e.g. "Business Certificate", "Director Ghana Card"
  fileUrl       String
  uploadedAt    DateTime     @default(now())

  @@index([applicationId])
}

// Platform-level KYC settings — one row (id = "global")
model KYCSettings {
  id                            String  @id @default("global")
  requireBusinessRegNumber      Boolean @default(false)
  requireBusinessCertUpload     Boolean @default(false)
  requireDirectorGhanaCardNumber Boolean @default(true)
  requireDirectorGhanaCardUpload Boolean @default(false)
  requireAgentGhanaCardNumber   Boolean @default(true)
  requireAgentGhanaCardUpload   Boolean @default(false)
  updatedAt                     DateTime @updatedAt
  updatedByEmail                String?
}

model PlatformSettings {
  id                   String   @id @default("global")
  idleTimeoutMinutes   Int      @default(5)   // client-side idle → sign out
  sessionMaxHours      Int      @default(4)   // absolute JWT lifetime from login
  updatedAt            DateTime @updatedAt
  updatedByEmail       String?
}

model PlatformAuditLog {
  id         String   @id @default(uuid())
  actorEmail String
  action     String
  entity     String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
}

// =====================
// BILLING — ENUMS
// =====================

enum BillingCycle {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

// =====================
// BILLING — FEATURE MODULES
// =====================

// Master catalogue of billable platform features/modules.
// Platform admin manages this list; one row per distinct feature.
model FeatureModule {
  id          String   @id @default(uuid())
  key         String   @unique  // e.g. "pos", "accounting", "payroll" — maps to tenant flag
  name        String            // e.g. "POS Module"
  description String?
  category    String   @default("Module")  // "Module", "Add-on", "Service"
  isActive    Boolean  @default(true)

  // Pricing
  setupFee    Float    @default(0)
  monthlyFee  Float    @default(0)
  yearlyFee   Float    @default(0)
  oneTimeFee  Float    @default(0)
  discount    Float    @default(0)  // percentage 0-100
  commissionRate Float @default(0)  // percentage 0-100
  vatRate     Float    @default(0)  // percentage e.g. 15 for 15%

  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planFeatures  TenantPlanFeature[]
  commissions   AgentCommission[]
  invoiceLines  InvoiceLineItem[]
}

// Billable hardware / physical items
model BusinessItem {
  id              String       @id @default(uuid())
  name            String
  description     String?
  sellingPrice    Float        @default(0)
  commissionRate  Float        @default(0)  // percentage 0-100
  billingCycle    BillingCycle @default(ONE_TIME)
  vatRate         Float        @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  planItems    TenantPlanItem[]
  commissions  AgentCommission[]
  invoiceLines InvoiceLineItem[]
}

// =====================
// BILLING — TENANT PLANS
// =====================

// One business plan per tenant (upsert pattern: tenantId is unique)
model TenantBusinessPlan {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  name      String?  // e.g. "Standard Plan"
  notes     String?
  billingCycle BillingCycle @default(MONTHLY)
  discount  Float    @default(0)  // plan-level discount percentage
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdByEmail String?

  features  TenantPlanFeature[]
  items     TenantPlanItem[]
  invoices  TenantInvoice[]

  @@index([tenantId])
}

// Feature row on a tenant plan
model TenantPlanFeature {
  id        String   @id @default(uuid())
  planId    String
  plan      TenantBusinessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   FeatureModule      @relation(fields: [featureId], references: [id])
  // Per-feature overrides (null = use module default)
  setupFee  Float?
  monthlyFee Float?
  yearlyFee Float?
  oneTimeFee Float?
  discount  Float?
  createdAt DateTime @default(now())

  @@unique([planId, featureId])
  @@index([planId])
}

// Hardware/item row on a tenant plan
model TenantPlanItem {
  id         String   @id @default(uuid())
  planId     String
  plan       TenantBusinessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemId     String
  item       BusinessItem       @relation(fields: [itemId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float?   // override; null = use item.sellingPrice
  discount   Float?
  createdAt  DateTime @default(now())

  @@index([planId])
}

// =====================
// BILLING — INVOICES
// =====================

model TenantInvoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique  // e.g. "INV-2026-0001"
  planId        String
  plan          TenantBusinessPlan @relation(fields: [planId], references: [id])
  tenantId      String
  tenantName    String        // snapshot
  billingCycle  BillingCycle
  status        InvoiceStatus @default(DRAFT)
  subtotal      Float         @default(0)
  vatAmount     Float         @default(0)
  discountAmount Float        @default(0)
  total         Float         @default(0)
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  createdByEmail String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lineItems     InvoiceLineItem[]
  commissions   AgentCommission[]

  @@index([tenantId])
  @@index([status])
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     TenantInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  discount    Float    @default(0)
  vatRate     Float    @default(0)
  vatAmount   Float    @default(0)
  lineTotal   Float    // (unitPrice * quantity) - discount + vatAmount
  featureId   String?
  feature     FeatureModule? @relation(fields: [featureId], references: [id])
  itemId      String?
  item        BusinessItem?  @relation(fields: [itemId], references: [id])
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

// =====================
// BILLING — COMMISSIONS
// =====================

model AgentCommission {
  id            String           @id @default(uuid())
  agentId       String
  agent         Agent            @relation(fields: [agentId], references: [id])
  tenantId      String
  tenantName    String           // snapshot
  invoiceId     String
  invoice       TenantInvoice    @relation(fields: [invoiceId], references: [id])
  featureId     String?
  feature       FeatureModule?   @relation(fields: [featureId], references: [id])
  itemId        String?
  item          BusinessItem?    @relation(fields: [itemId], references: [id])
  description   String
  saleAmount    Float            // invoice line amount commission was computed on
  commissionRate Float
  commissionAmount Float
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([agentId])
  @@index([tenantId])
  @@index([invoiceId])
}

// =====================
// PAYROLL — DYNAMIC COMPONENTS
// =====================

// Tenant-level catalogue of allowance/deduction types
model PayrollComponent {
  id          String               @id @default(uuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  name        String
  type        PayrollComponentType
  subType     String?              // e.g. "TRANSPORT", "HOUSING", "LOAN_REPAYMENT"
  isTaxable   Boolean              @default(false) // for ALLOWANCE: adds to taxable income
  isBeforeTax Boolean              @default(true)  // for DEDUCTION: deducted before PAYE
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())

  assignments EmployeePayrollComponent[]

  @@index([tenantId])
}

// Assignment of a component to a specific employee with an amount
model EmployeePayrollComponent {
  id            String           @id @default(uuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId   String
  component     PayrollComponent @relation(fields: [componentId], references: [id])
  amount        Float
  isActive      Boolean          @default(true)
  effectiveFrom DateTime         @default(now())
  effectiveTo   DateTime?

  @@index([employeeId])
  @@index([componentId])
}

// Tenant-configurable statutory deduction rates (SSF, PAYE flags, etc.)
model StatutoryDeduction {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  code       String                    // "SSF_EMPLOYEE" | "SSF_EMPLOYER"
  rate       Float
  appliesTo  String   @default("BASIC") // "BASIC" | "GROSS"
  isActive   Boolean  @default(true)

  @@unique([tenantId, code])
  @@index([tenantId])
}

// Employee loans tracked for automatic monthly deductions
model EmployeeLoan {
  id               String         @id @default(uuid())
  tenantId         String
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id])
  description      String
  principalAmount  Float
  balanceAmount    Float
  monthlyDeduction Float
  startDate        DateTime
  endDate          DateTime?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  repayments LoanRepayment[]

  @@index([tenantId])
  @@index([employeeId])
}

// One row per loan per payroll run (records repayment and reduces balance)
model LoanRepayment {
  id            String       @id @default(uuid())
  loanId        String
  loan          EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payrollLineId String?
  /// Which payroll run recorded this repayment. Without it a deleted draft run
  /// left the repayment orphaned and the loan permanently credited for money
  /// the employee never actually repaid.
  payrollRunId  String?
  amount        Float
  paidAt        DateTime     @default(now())

  @@index([loanId])
  @@index([payrollRunId])
}

model PayrollDepartment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

// =====================
// WAYBILLS / DELIVERY NOTES
// =====================

model Waybill {
  id             String        @id @default(uuid())
  tenantId       String
  branchId       String?

  // Auto-generated document number e.g. "WB-2026-0001"
  waybillNumber  String

  status         WaybillStatus @default(DRAFT)

  // Link to the originating sale (optional — can be a standalone delivery)
  saleId         String?

  // Shipper (sender) details — pre-filled from tenant/branch, editable
  shipperName    String
  shipperAddress String?
  shipperPhone   String?

  // Consignee (recipient) details
  consigneeName    String
  consigneeAddress String
  consigneePhone   String?

  // Carrier / logistics details
  driverName     String?
  vehicleNumber  String?
  carrierName    String?        // transport company name if any

  // Dispatch & delivery timestamps + user stamps
  dispatchedAt   DateTime?
  dispatchedById String?
  deliveredAt    DateTime?
  deliveredById  String?

  // Delivery note / special instructions
  notes          String?

  // Recipient signature note (captured on delivery confirmation)
  receivedBy     String?        // name of person who physically received goods

  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items WaybillItem[]

  @@unique([tenantId, waybillNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([saleId])
}

model WaybillItem {
  id          String  @id @default(uuid())
  waybillId   String
  waybill     Waybill @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  // Snapshot fields — independent of Item record
  description String
  quantity    Float
  unit        String  @default("pcs")
  weight      Float?  // kg — optional
  notes       String?

  @@index([waybillId])
}
